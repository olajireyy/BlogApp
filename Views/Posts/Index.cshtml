@model List<BlogApp.Models.Post>
@{
    ViewData["Title"] = "Writing";
}

<div class="page-header">
    <div>
        <p class="sub">All entries</p>
        <h1>Writing</h1>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ New Post</a>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <h2>Nothing here yet.</h2>
        <p><a asp-action="Create" style="color:var(--accent)">Write the first post.</a></p>
    </div>
}
else
{
    @foreach (var post in Model)
    {
        <div class="post-card">
            <div>
                <h2 class="post-card-title">
                    <a asp-action="Details" asp-route-id="@post.Id">@post.Title</a>
                </h2>
                <p class="post-card-excerpt">
                    @(post.Content.Length > 160 ? post.Content[..160] + "…" : post.Content)
                </p>
                <span class="post-card-meta">
                    @post.CreatedAt.ToString("MMMM dd, yyyy")
                </span>
            </div>
            <div class="post-card-actions">
                <a asp-action="Edit" asp-route-id="@post.Id"
                   class="btn btn-ghost btn-sm">Edit</a>
            </div>
        </div>
    }
}