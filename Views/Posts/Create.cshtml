@model BlogApp.Models.Post
@{
    ViewData["Title"] = "New Post";
}
@* For Edit.cshtml change to: ViewData["Title"] = "Edit Post"; *@

<div class="form-page">
    <h1>New Post</h1>
    @* For Edit.cshtml change to: <h1>Edit Post</h1> *@

    <form asp-action="Create" method="post">
        @* For Edit.cshtml: asp-action="Edit" asp-route-id="@Model.Id" *@
        <div class="mb-4">
            <label asp-for="Title" class="form-label"></label>
            <input asp-for="Title" class="form-control"
                   placeholder="Post title" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Content" class="form-label"></label>
            <textarea asp-for="Content" class="form-control"
                      placeholder="Write something…"></textarea>
            <span asp-validation-for="Content" class="text-danger"></span>
        </div>

        <div class="d-flex gap-3 align-items-center">
            <button type="submit" class="btn btn-primary">Publish</button>
            <a asp-action="Index" class="btn btn-ghost">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}